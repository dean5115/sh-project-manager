# משתני סביבה לפרודקשן (Render) — להגדיר ב-Render Dashboard → Environment, לא בקובץ הזה

# מ-Supabase: אריח "ORM" בעמוד הפרויקט → Prisma
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# מפתח חדש ואקראי — נוצר לכם, אפשר גם ליצור אחר עם: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="40d3145552efbf268c97f7a54549bc01f882995d6a1a015fc71af5bb06c78ba1"

PORT=10000
NODE_ENV="production"

# כתובת האתר ב-Vercel (לאחר שתעלו אותו) — לצורך קישורים בהתראות/מיילים
FRONTEND_URL="https://your-app.vercel.app"

# דומיינים נוספים שמורשים לקרוא ל-API (חוץ מ-*.vercel.app שמורשה אוטומטית), מופרדים בפסיק
CORS_ORIGINS=""

# Cloudflare R2 — Dashboard → R2 → צרו bucket → Manage R2 API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="sh-pm-uploads"
# כתובת ציבורית של ה-bucket (R2.dev URL או דומיין מחובר) — בלי slash בסוף
R2_PUBLIC_URL=""

# Email (Gmail SMTP) — ב-Google Account → Security → App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SH - Project Manager <your-email@gmail.com>"
